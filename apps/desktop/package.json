{
  "name": "@frontagent/desktop",
  "version": "2.1.1",
  "description": "FrontAgent desktop app (Electron) — standalone GUI entry point reusing the Node runtime spine",
  "private": true,
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@frontagent/core": "workspace:*",
    "@frontagent/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.7"
  }
}
